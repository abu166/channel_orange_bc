# All optional. With no keys the app runs on rule-based extraction + live PubMed.
# Free AI (pick ONE): Groq is fastest — get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Or Google Gemini free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or OpenRouter free models / Anthropic
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Override the model id for whichever provider is active
AI_MODEL=
# Raises PubMed rate limit from 3 to 10 req/s — https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
